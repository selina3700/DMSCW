<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>

<?import java.net.URL?>
<?import javafx.scene.layout.HBox?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.comp2042.PauseMenu"
           maxWidth="Infinity" maxHeight="Infinity" styleClass="pause-root">

    <VBox alignment="CENTER" spacing="20" styleClass="buttons-container"
          prefHeight="498" prefWidth="402" maxHeight="498" maxWidth="402">
        <!-- Logo -->
        <ImageView fx:id="logoImage" fitWidth="346" fitHeight="219" preserveRatio="true" />
        <ImageView fx:id="optionsButton" fitWidth="276" fitHeight="57"/>
        <ImageView fx:id="quitButton" fitWidth="276" fitHeight="57"/>
        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="40">
            <ImageView fx:id="mainMenuButton" fitWidth="65" fitHeight="65"/>
            <ImageView fx:id="restartButton" fitWidth="65" fitHeight="65"/>
            <ImageView fx:id="resumeButton" fitWidth="65" fitHeight="65"/>
        </HBox>

    </VBox>

    <stylesheets>
        <URL value="@pauseMenu.css"/>
    </stylesheets>
</StackPane>