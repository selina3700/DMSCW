<?import com.comp2042.menu.GameOverPanel?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.Group?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<Pane fx:controller="com.comp2042.controllers.GuiController"
      xmlns:fx="http://javafx.com/fxml">

    <Pane layoutX="140" layoutY="10">
        <!-- Main game board -->
        <BorderPane styleClass="gameBoard" fx:id="gameBoard">
            <center>
                <StackPane alignment="TOP_LEFT">
                    <GridPane fx:id="gamePanel"/>
                    <GridPane fx:id="brickPanel"
                              mouseTransparent="true"
                              pickOnBounds="false"
                              vgap="0" hgap="0"/>
                </StackPane>
            </center>
        </BorderPane>

        <!-- Notifications & game over panel -->
        <Group fx:id="groupNotification" layoutX="14" layoutY="203">
            <VBox alignment="CENTER">
                <GameOverPanel fx:id="gameOverPanel" />
            </VBox>
        </Group>
    </Pane>
    <VBox fx:id="leftPanel" layoutX="-2" layoutY="10">
        <!-- Score label -->
        <Label fx:id="scoreLabel" text="Score: 0"
               styleClass="bindScoreStyle" minWidth="120" minHeight="30"
               maxWidth="120" maxHeight="30"
        />

        <!-- Level Label -->
        <Label fx:id="levelLabel" text="Level: 1"
               styleClass="scoreClass"
        />

        <!-- Lines cleared label -->
        <Label fx:id="linesLabel"
               text="Lines: 0"
               styleClass="scoreClass"
        />

        <!-- Next Brick -->
        <VBox fx:id="nextBrickContainer" spacing="10" alignment="CENTER">

            <Label fx:id="nextBrickLabel" text="Next:" styleClass="nextBrickLabel"/>
            <GridPane fx:id="nextBrickPanel" styleClass="nextBrick"
                      prefWidth="100" prefHeight="100"
                      minWidth="100" maxWidth="100"
                      minHeight="100" maxHeight="100"
                      alignment="CENTER" hgap="0" vgap="0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints percentHeight="25"/><RowConstraints percentHeight="25"/><RowConstraints percentHeight="25"/><RowConstraints percentHeight="25"/>
                </rowConstraints>
            </GridPane>

            <Label fx:id="holdBrickLabel" text="Hold:" styleClass="holdBrickLabel"/>
            <GridPane fx:id="holdBrickPanel" styleClass="holdBrick"
                      prefWidth="100" prefHeight="100"
                      minWidth="100" maxWidth="100"
                      minHeight="100" maxHeight="100"
                      alignment="CENTER" hgap="0" vgap="0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/><ColumnConstraints percentWidth="25"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints percentHeight="25"/><RowConstraints percentHeight="25"/><RowConstraints percentHeight="25"/><RowConstraints percentHeight="25"/>
                </rowConstraints>
            </GridPane>

        </VBox>
    </VBox>

    <Pane fx:id="buttonGroup" layoutX="380" layoutY="10" prefWidth="200" prefHeight="100"/>

    <stylesheets>
        <URL value="@window_style.css"/>
    </stylesheets>
</Pane>