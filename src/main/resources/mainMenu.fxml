<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.comp2042.menu.MainMenu"
           fx:id="root">

    <VBox alignment="CENTER" spacing="10" styleClass="buttons-container"
          prefHeight="515" prefWidth="415" maxHeight="515" maxWidth="415">

        <ImageView fx:id="logoImage" fitWidth="346" fitHeight="219" preserveRatio="true" />

        <VBox fx:id="buttonContainer" alignment="CENTER" spacing="9" />

    </VBox>

    <stylesheets>
        <URL value="@Menu.css"/>
    </stylesheets>
</StackPane>