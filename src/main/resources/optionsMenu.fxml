<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import java.net.URL?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.comp2042.OptionsMenu"
           maxWidth="Infinity" maxHeight="Infinity"
           styleClass="pause-root">

    <VBox alignment="CENTER" spacing="30"
          prefWidth="500" prefHeight="600"
          styleClass="buttons-container">

        <!-- Logo -->
        <ImageView fx:id="logoImage"
                   fitWidth="350" fitHeight="150"
                   preserveRatio="true" />

        <!-- Music + SFX -->
        <HBox alignment="CENTER" spacing="80">
            <ImageView fx:id="musicButton"
                       fitWidth="70" fitHeight="70" />

            <ImageView fx:id="sfxButton"
                       fitWidth="70" fitHeight="70" />
        </HBox>

        <!-- Menu Buttons -->
        <ImageView fx:id="controlsButton"
                   fitWidth="280" fitHeight="60"/>

        <ImageView fx:id="mainMenuButton"
                   fitWidth="280" fitHeight="60"/>

        <ImageView fx:id="backButton"
                   fitWidth="280" fitHeight="60"/>

    </VBox>

    <stylesheets>
        <URL value="@Menu.css"/>
    </stylesheets>

</StackPane>
